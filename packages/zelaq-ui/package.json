{
    "name": "zelaq-ui",
    "version": "0.0.3",
    "description": "Cross-platform UI kit for React and React Native",
    "keywords": [
        "react",
        "react-native",
        "ui",
        "components",
        "design-system",
        "cross-platform",
        "typescript",
        "accessibility"
    ],
    "license": "MIT",
    "homepage": "https://github.com/MRArguello/zelaq/tree/main/packages/zelaq-ui#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MRArguello/zelaq.git",
        "directory": "packages/zelaq-ui"
    },
    "sideEffects": false,
    "source": "./src/index.ts",
    "main": "./lib/commonjs/index.js",
    "module": "./lib/module/index.js",
    "types": "./lib/typescript/commonjs/index.d.ts",
    "react-native": "./lib/module/index.js",
    "exports": {
        ".": {
            "react-native": {
                "types": "./lib/typescript/commonjs/index.d.ts",
                "default": "./lib/module/index.js"
            },
            "import": {
                "types": "./lib/typescript/module/index.d.ts",
                "default": "./lib/module/index.js"
            },
            "require": {
                "types": "./lib/typescript/commonjs/index.d.ts",
                "default": "./lib/commonjs/index.js"
            },
            "default": "./lib/module/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf lib",
        "build": "bob build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "prepack": "pnpm clean && pnpm build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0",
        "react-native": ">=0.81.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.0.0",
        "@eslint/js": "^9.39.1",
        "@storybook/addon-a11y": "^10.2.7",
        "@storybook/addon-docs": "^10.2.7",
        "@storybook/addon-vitest": "^10.2.7",
        "@storybook/react-vite": "^10.2.7",
        "@types/node": "^24.10.1",
        "@types/react": "~19.1.0",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/browser-playwright": "^4.0.18",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^9.39.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-native-a11y": "^3.5.1",
        "eslint-plugin-storybook": "^10.2.7",
        "globals": "^16.5.0",
        "lucide-react": "^1.31.0",
        "playwright": "^1.58.2",
        "react": "19.1.0",
        "react-dom": "^19.2.0",
        "react-native": "0.81.5",
        "react-native-builder-bob": "^0.40.18",
        "rimraf": "^6.0.1",
        "storybook": "^10.2.7",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4",
        "vitest": "^4.0.18"
    },
    "packageManager": "pnpm@9.15.0",
    "publishConfig": {
        "access": "public"
    }
}