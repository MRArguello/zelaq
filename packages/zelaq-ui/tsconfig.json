{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2020"
        ],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "declaration": false,
        "allowJs": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "baseUrl": ".",
        "paths": {
            "zelaq-ui": [
                "./src/index.ts"
            ],
            "zelaq-ui/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "lib",
        "node_modules"
    ]
}