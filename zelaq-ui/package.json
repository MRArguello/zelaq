{
    "name": "@zelaq/ui",
    "version": "0.1.0",
    "description": "Cross-platform component library for React and React Native",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/types/index.d.ts",
    "react-native": "src/index.ts",
    "git repository": "https://github.com/MRArguello/zelaq",
    "keywords": ["react", "react-native", "ui", "component-library", "cross-platform"],
    "author": "MRArguello",
    "license": "ISC",
    "files": [
        "dist",
        "src"
    ],
    "exports": {
        ".": {
            "react-native": "./src/index.native.ts",
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./provider": {
            "react-native": "./src/provider/index.native.ts",
            "types": "./dist/types/provider/index.d.ts",
            "import": "./dist/esm/provider/index.js",
            "require": "./dist/cjs/provider/index.js"
        },
        "./theme": {
            "types": "./dist/types/theme/index.d.ts",
            "import": "./dist/esm/theme/index.js",
            "require": "./dist/cjs/theme/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "react": "19.1.0",
        "react-native": "0.81.5",
        "styled-components": ">=5.3.0"
    },
    "peerDependencies": {
        "react": "19.1.0",
        "react-native": "0.81.5",
        "styled-components": ">=5.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.1.0",
        "@types/react-native": "^0.71.0",
        "@types/styled-components": "^5.1.26",
        "tsup": "^8.0.0",
        "typescript": "~5.9.2"
    }
}